#!/bin/bash
# switch-sensors: Prints processor temperature and fan speed for Nintendo Switch

temp=""
for tz in /sys/class/thermal/thermal_zone*; do
    if [ -f "$tz/type" ]; then
        name=$(cat "$tz/type" 2>/dev/null)
        case "$name" in
            *CPU*|*PLL*|*Tdiode*|*soc*|*tegra*)
                raw=$(cat "$tz/temp" 2>/dev/null)
                if [ -n "$raw" ] && [ "$raw" -gt 0 ] 2>/dev/null; then
                    temp="$((raw / 1000))°C"
                    break
                fi
                ;;
        esac
    fi
done

if [ -z "$temp" ]; then
    for tz in /sys/class/thermal/thermal_zone*; do
        if [ -f "$tz/temp" ]; then
            raw=$(cat "$tz/temp" 2>/dev/null)
            if [ -n "$raw" ] && [ "$raw" -ge 10000 ] && [ "$raw" -le 115000 ] 2>/dev/null; then
                temp="$((raw / 1000))°C"
                break
            fi
        fi
    done
fi
[ -z "$temp" ] && temp="--°C"

fan=""
rpm=""
pwm_pct=""

for p in /sys/devices/pwm-fan /sys/bus/platform/devices/pwm-fan; do
    if [ -d "$p" ]; then
        # Ensure tachometer is enabled
        [ -w "$p/tach_enable" ] && [ "$(cat "$p/tach_enable" 2>/dev/null)" != "1" ] && echo 1 > "$p/tach_enable" 2>/dev/null || true

        if [ -f "$p/rpm_measured" ]; then
            r=$(cat "$p/rpm_measured" 2>/dev/null)
            [ -n "$r" ] && [ "$r" -ge 0 ] 2>/dev/null && rpm="${r} RPM"
        fi
        if [ -f "$p/cur_pwm" ]; then
            pwm=$(cat "$p/cur_pwm" 2>/dev/null)
            [ -n "$pwm" ] && pwm_pct="$(( (pwm * 100) / 255 ))%"
        elif [ -f "$p/target_pwm" ]; then
            pwm=$(cat "$p/target_pwm" 2>/dev/null)
            [ -n "$pwm" ] && pwm_pct="$(( (pwm * 100) / 255 ))%"
        fi
        break
    fi
done

[ -z "$pwm_pct" ] && pwm_pct="50%"

if [ -n "$rpm" ]; then
    fan="${pwm_pct} (${rpm})"
else
    fan="${pwm_pct}"
fi

# If run interactively in a terminal or with --plain, output single plain line
if [ -t 1 ] || [ "$1" = "--plain" ]; then
    echo "${temp} | Fan: ${fan}"
    exit 0
fi

# Otherwise (e.g. running under xfce4-genmon-plugin), format with XML tags
echo "<txt>🌡 ${temp} | 🌀 ${fan}</txt>"
echo "<tool>Nintendo Switch Sensors&#10;Temperatura: ${temp}&#10;Ventilador: ${fan}&#10;Clic para abrir Tegra Stats</tool>"
echo "<click>x-terminal-emulator -e tegrastats</click>"
